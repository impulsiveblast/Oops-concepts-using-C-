//overloading 

class Animal{

public :    
    void Bark(string s1,string s2){
        cout<<s1+s2<<endl;
    }
    
    void Bark(int a1,int a2)
    {
        cout<<a1<<" "<<"Can bark but not "<<a2;
    }
};

class Dog: public Animal{
    
    public:
    
    void Bark(string s1,int t)
    {
        cout<<s1<<" "<<"Barks "<<t<<" times"<<endl;
    }
};




