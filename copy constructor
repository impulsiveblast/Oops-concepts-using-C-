#include<bits/stdc++.h>
using namespace std;

class Number{
    
    public:
    int a;
    
    
    
    Number(){
        
    }
    
    Number(int k)   //parametrised constructor
    {
        a=k;
    }
    
    Number(Number &object)  //copy constructor :it has to be of the same name
    {
        a=object.a;
    }
};

int main()
{
    Number a1(22),b1(35);
    
    cout<<a1.a<<endl;
    cout<<b1.a<<endl;
    
    Number c1(a1);
    cout<<endl;
    cout<<a1.a<<endl;
    cout<<c1.a<<endl;
    
}
